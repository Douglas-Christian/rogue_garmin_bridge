# Virtual Environment
# Ignore the venv directory
venv/
# All contents of venv dir
venv/**
# venv in any subdirectory
**/venv/
# venv relative to root
/venv/
# All files in venv
venv/**/*
# Other common names for virtual environments
env/
ENV/
.env/
.venv/
*venv/
*env/
